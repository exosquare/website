---
import Base from '../../../layouts/Base.astro';
import { withBase } from '../../../lib/paths';

const url = withBase('/experiments/moonshine-stt/');
const syntheticUrl = withBase('/experiments/moonshine-stt/?synthetic=1');
---

<Base
  title="On-device speech"
  description="Load Moonshine Base in the browser, then transcribe from the microphone. Audio stays on the device."
>
  <div class="play-view">
    <h1>On-device speech</h1>
    <p>
      Press Load demo before anything is downloaded. The first visit is about
      160 MB (Base weights plus the runtime). Weights are fetched once from
      Hugging Face and stored in the browser cache. Later visits load from that
      cache. Audio never leaves the device. The demo works best on WebGPU. Start
      the microphone only after the model is ready. To download the weights
      again, use DevTools &gt; Application &gt; Storage &gt; Clear site data.
      Disable cache does not bypass Cache Storage.
      <a href={syntheticUrl}>Open with a synthetic source</a> if this machine has
      no microphone.
    </p>
    <iframe
      src={url}
      title="On-device Moonshine speech recognition. Press Load demo before anything is downloaded, then start the microphone."
      sandbox="allow-scripts allow-same-origin"
      allow="microphone"></iframe>
  </div>
</Base>

<style>
  .play-view {
    width: min(100% - 32px, 1100px);
    margin: 40px auto 64px;
  }
  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
  p {
    max-width: 680px;
    margin: 12px 0 24px;
    line-height: 1.6;
  }
  iframe {
    display: block;
    width: 100%;
    height: 1040px;
    border: 1px solid var(--rule);
    background: #fff;
  }
</style>
