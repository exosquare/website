---
import Base from '../../../layouts/Base.astro';
import { withBase } from '../../../lib/paths';
---

<Base title="Pong demonstration" description="Play the local Pong demonstration in this tab." draft>
  <div class="play-view">
    <h1>Pong demonstration</h1>
    <p>
      Demonstration weights. No official score.
      <a href={withBase('/experiments/pong/')}>Open the standalone page</a>.
    </p>
    <iframe
      src={withBase('/experiments/pong/')}
      title="Pong demonstration. New serve, pause, and step play the authored weights in this frame."
      sandbox="allow-scripts allow-same-origin"></iframe>
  </div>
</Base>

<style>
  .play-view {
    width: min(100% - 32px, 1100px);
    margin: 40px auto 64px;
  }
  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
  p {
    max-width: 680px;
    margin: 12px 0 24px;
    line-height: 1.6;
  }
  iframe {
    display: block;
    width: 100%;
    height: calc(100dvh - 180px);
    min-height: 640px;
    border: 1px solid var(--rule);
    background: #101315;
  }
</style>
