---
import Base from '../../../layouts/Base.astro';
import PongArena from '../../../components/pong/PongArena.astro';
---

<Base
  title="Weight-space Pong"
  description="Watch two small networks play Pong, inspect their decisions and run a knockout tournament."
>
  <div class="arena-wrap">
    <h1>Weight-space Pong</h1>
    <PongArena />
  </div>
</Base>
<style>
  .arena-wrap {
    width: min(94%, 1240px);
    margin: clamp(24px, 5vw, 72px) auto;
  }
  h1 {
    font-size: clamp(2.3rem, 6vw, 5.5rem);
    letter-spacing: -0.065em;
    line-height: 1;
    margin-bottom: 0.5em;
  }
</style>
