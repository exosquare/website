---
interface Props {
  contributors: { name: string; did: string; url?: string }[];
}
const { contributors } = Astro.props;
---

{
  contributors.length > 0 && (
    <section class="editorial-grid record-section">
      <>
        <h2 class="eyebrow">Contributors</h2>
        <dl class="contributor-credits">
          {contributors.map((c) => (
            <div>
              <dt>
                {c.url ? (
                  <a class="text-link" href={c.url}>
                    {c.name}
                  </a>
                ) : (
                  c.name
                )}
              </dt>
              <dd>{c.did}</dd>
            </div>
          ))}
        </dl>
      </>
    </section>
  )
}
