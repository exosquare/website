---
import { withBase } from '../lib/paths';
import site from '../data/site.json';
---

<section class="contact-invite">
  <h2>{site.invite}</h2><div>
    <p>
      Project enquiries, collaboration proposals, and
      thoughtful conversations are all welcome.
    </p><a
      class="text-link"
      href={site.email ? `mailto:${site.email}` : withBase('/contact/')}
      >{site.email || 'Get in touch'} <span aria-hidden="true">↗</span></a
    >
  </div>
</section>
