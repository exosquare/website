  <picture>
    <source media="(max-width: 600px)" srcset={withBase('/images/mirage/how-it-works-mobile.webp')} width="600" height="800" />
    <img src={withBase('/images/mirage/how-it-works.webp')} width="1200" height="630" loading="lazy" decoding="async" alt="Two separate paths: a scan reads receipt text for the app to process. A form request uses the image and supplied answer choices, without the text reader or earlier scan text." />
