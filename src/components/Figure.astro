---
import { withBase } from '../lib/paths';
interface Props {
  src: string;
  alt: string;
  caption?: string;
  label?: string;
  hero?: boolean;
  width?: number;
  height?: number;
  preserveColor?: boolean;
}
const {
  src,
  alt,
  caption,
  label,
  hero = false,
  width,
  height,
  preserveColor = false,
} = Astro.props;
---

<figure class:list={['content-figure', { 'hero-figure': hero }]}>
  <img
    src={withBase(src)}
    alt={alt}
    width={width}
    height={height}
    class:list={{
      'original-color': preserveColor,
      'intrinsic-ratio': width && height,
    }}
    loading={hero ? 'eager' : 'lazy'}
    fetchpriority={hero ? 'high' : undefined}
    decoding="async"
  />{
    (caption || label) && (
      <figcaption>
        {label && <span class="mono">{label}</span>} {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .original-color {
    filter: none;
  }
  .content-figure img.intrinsic-ratio {
    aspect-ratio: auto;
  }
</style>
