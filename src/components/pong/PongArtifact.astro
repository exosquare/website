---
import { withBase } from '../../lib/paths';

const url = withBase('/experiments/pong/');
const playUrl = withBase('/experiments/play/pong-inspector/');
---

<figure class="pong-artifact">
  <iframe
    src={url}
    title="Pong demonstration. New serve, pause, and step play the authored weights in this frame."
    sandbox="allow-scripts"
    loading="lazy"></iframe>
  <figcaption>
    The player starts with demonstration weights, separate from the evaluated list. <a href={playUrl}>Open a larger view</a>.
  </figcaption>
</figure>

<script>
  const MIN_HEIGHT = 480;
  const MAX_HEIGHT = 20000;
  document.querySelectorAll<HTMLIFrameElement>('.pong-artifact iframe').forEach((frame) => {
    let applied = 0;
    window.addEventListener('message', (event) => {
      if (event.source !== frame.contentWindow) return;
      const data = event.data;
      if (!data || typeof data !== 'object') return;
      if (data.type !== 'pong-embed-height') return;
      if (typeof data.height !== 'number' || !Number.isFinite(data.height)) return;
      const height = Math.round(data.height);
      if (height < MIN_HEIGHT || height > MAX_HEIGHT) return;
      if (Math.abs(height - applied) < 2) return;
      applied = height;
      frame.style.height = `${height}px`;
    });
  });
</script>

<style>
  .pong-artifact {
    margin: 36px 0;
    width: calc(100% + var(--article-gutter, 0px));
    margin-left: calc(-1 * var(--article-gutter, 0px));
  }
  iframe {
    display: block;
    width: 100%;
    height: 720px;
    border: 1px solid var(--rule);
    background: #101315;
  }
  figcaption {
    margin-top: 12px;
    margin-left: var(--article-gutter, 0px);
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  @media (min-width: 761px) {
    .pong-artifact {
      --article-gutter: 200px;
    }
  }
  @media (min-width: 1001px) {
    .pong-artifact {
      --article-gutter: 284px;
    }
  }
</style>
