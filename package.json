{
  "name": "exosquare-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "npm run lint:content && astro build && npm run verify:output",
    "build:preview": "npm run lint:content && PREVIEW_DRAFTS=true astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint:content": "node scripts/lint-content.mjs",
    "format": "prettier --write \"src/**/*.{astro,css,ts,json,md,mdx}\" \"scripts/*.mjs\" \"*.{json,mjs}\"",
    "verify:output": "node scripts/verify-output.mjs",
    "dev:drafts": "PREVIEW_DRAFTS=true astro dev --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/space-mono": "5.3.0",
    "astro": "7.3.1",
    "qrcode": "1.5.4",
    "nostr-tools": "2.25.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/qrcode": "1.5.6",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
